# Local preview is the default. Preview never sends external email.
APP_MODE=preview
HOST=127.0.0.1
PORT=8766
SITE_URL=http://127.0.0.1:8766

# Set these ONLY in .env or server environment. Never send secrets in chat.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=obogrevsistem@yandex.ru
SMTP_PASSWORD=
FORM_SECRET=

# Production requires finished legal documents and actual operator details.
LEGAL_OPERATOR=
LEGAL_ADDRESS=
LEGAL_APPROVED=0

# Numeric counter ID. Disabled in preview regardless of this setting.
METRIKA_ID=
TRUST_PROXY=0
